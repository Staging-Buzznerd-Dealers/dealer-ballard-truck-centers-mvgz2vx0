{
  "version": 2,
  "nodes": [
    {
      "id": "hero-band",
      "type": "section",
      "props": {
        "width": "boxed",
        "background": "ink",
        "paddingY": 0,
        "align": "center",
        "behaviour": "rotator",
        "behaviourOptions": "{\"autoplay\":7000}"
      },
      "children": [
        {
          "id": "hero-slide-vnx",
          "type": "row",
          "props": { "gap": 6, "align": "center", "part": "slide" },
          "children": [
            {
              "id": "hero-vnx-copy",
              "type": "column",
              "props": { "span": 5, "align": "center" },
              "children": [
                { "id": "hero-vnx-h", "type": "heading", "props": { "text": "The All-New\nVolvo VNX", "headingLevel": 1 } },
                {
                  "id": "hero-vnx-t",
                  "type": "text",
                  "props": {
                    "text": "The all-new Volvo VNX combines rugged capability, advanced safety, and enhanced driver comfort for the toughest jobs.",
                    "width": "full"
                  }
                }
              ]
            },
            { "id": "hero-vnx-space", "type": "column", "props": { "span": 7 }, "children": [] }
          ]
        }
      ]
    },
    {
      "id": "brands",
      "type": "section",
      "props": { "width": "boxed", "background": "card", "paddingY": 6 },
      "children": [
        {
          "id": "brands-strip",
          "type": "logoStrip",
          "props": {
            "logos": [
              { "name": "Mack" },
              { "name": "Volvo" },
              { "name": "Isuzu" },
              { "name": "Hino" },
              { "name": "Tico" },
              { "name": "Reitnouer" },
              { "name": "Trail King" },
              { "name": "XL Specialized" }
            ]
          }
        }
      ]
    },
    {
      "id": "requests",
      "type": "section",
      "props": { "width": "boxed", "background": "card", "paddingY": 6 },
      "children": [
        {
          "id": "requests-row",
          "type": "row",
          "props": { "gap": 7, "align": "start", "stackOn": "tablet" },
          "children": [
            {
              "id": "service-card",
              "type": "column",
              "props": { "span": 6, "padding": 7, "background": "card" },
              "children": [
                {
                  "id": "service-form",
                  "type": "form",
                  "props": {
                    "formId": "service-request",
                    "anchor": "service-request",
                    "heading": "Service Request Form",
                    "headingLevel": 2,
                    "intro": "To schedule service on your vehicle, you may contact us using the form below. If you need immediate assistance, please call us at (800) 421-1576."
                  }
                }
              ]
            },
            {
              "id": "parts-card",
              "type": "column",
              "props": { "span": 6, "padding": 7, "background": "card" },
              "children": [
                {
                  "id": "parts-form",
                  "type": "form",
                  "props": {
                    "formId": "parts-request",
                    "anchor": "parts-request",
                    "heading": "Parts Request Form",
                    "headingLevel": 2,
                    "intro": "To order or learn more about parts, you may contact us using the form below. If you need immediate assistance, please call us at (800) 421-1576."
                  }
                }
              ]
            }
          ]
        }
      ]
    },
    {
      "id": "featured-band",
      "type": "section",
      "props": { "width": "boxed", "background": "accent", "paddingY": 7 },
      "children": [
        { "id": "featured-h", "type": "heading", "props": { "text": "Browse Our Featured Trucks & Trailers", "headingLevel": 2, "align": "center" } },
        {
          "id": "featured",
          "type": "widget",
          "props": { "widget": "inventory-carousel", "config": { "limit": 8 } }
        }
      ]
    },
    {
      "id": "departments",
      "type": "section",
      "props": { "width": "boxed", "background": "card", "paddingY": 7, "anchor": "departments" },
      "children": [
        {
          "id": "quick",
          "type": "iconGrid",
          "props": {
            "heading": "Reliable Service Across Every Department",
            "headingLevel": 2,
            "items": [
              {
                "label": "Sales",
                "desc": "We sell hard working trucks and trailers that serve hard working people like you. Work with our knowledgeable team to find the best solution for your line of work.",
                "url": "/store/inventory"
              },
              {
                "label": "Service",
                "desc": "Our factory-trained technicians and expansive dealership network help reduce the time your trucks sit at our shops, getting them back on the road as quickly and efficiently as possible.",
                "url": "#service-request"
              },
              {
                "label": "Parts",
                "desc": "We offer a large selection of OEM parts and a wide range of aftermarket parts and accessories for all makes/models, enabling us to carry what you need, when you need it.",
                "url": "#parts-request"
              },
              {
                "label": "Lease & Rent",
                "desc": "Our Ballard Lease & Rent program is offered at all of our dealerships across New England, so you can easily find the perfect truck and financing option for your needs."
              }
            ]
          }
        }
      ]
    },
    {
      "id": "reviews",
      "type": "section",
      "props": { "width": "boxed", "background": "accent", "paddingY": 7 },
      "children": [
        {
          "id": "reviews-list",
          "type": "testimonials",
          "props": {
            "heading": "Hear What Our Customers Have to Say",
            "headingLevel": 2,
            "items": [
              {
                "name": "Rishabh",
                "role": "Google review",
                "rating": 5,
                "quote": "Awesome place. Got here overnight. They open at 6 am and my truck was in a bay at 6:15 am. Truck repaired for a leaky front differential filter. Done and dusted by 8:45 am."
              },
              {
                "name": "Alexander Cabral",
                "role": "Google review",
                "rating": 5,
                "quote": "Excellent quality parts and usually have what you need in stock or can get it fast. Highly recommended."
              },
              {
                "name": "Bruce Maxwell",
                "role": "Google review",
                "rating": 5,
                "quote": "Awesome service and always have the parts needed for any job. Service always has a positive attitude making for a great experience every time. 10/10 recommend"
              },
              {
                "name": "Soban Peng",
                "role": "Google review",
                "rating": 5,
                "quote": "Parts department always gets the stuff I need. Everyone is knowledgeable and if any issues arise they communicate with me. Great parts department."
              },
              {
                "name": "Duane Boucher",
                "role": "Google review",
                "rating": 5,
                "quote": "Great to have this dealer located closer to the Cape for convenience. They are always responsive to our needs."
              }
            ]
          }
        }
      ]
    }
  ]
}
