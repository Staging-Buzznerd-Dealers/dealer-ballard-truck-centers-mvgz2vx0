    {
      "id": "ab-tl-b",
      "type": "sharedSection",
      "props": {
        "sectionId": "timeline",
        "values": {
          "entries": [
            {
              "title": "The Ballard Name",
              "years": "1988–1999",
              "text": "<strong>1988</strong>: Bob Picking and Janet Grahn acquired Worcester Mack, rebranding it Ballard Mack Sales & Service. Steve Grahn, Janet’s son, joined the team shortly after.\n\n<strong>1990s</strong>: The company shifted focus from consumer vehicles to commercial trucks, closing Ballard Motor Sales and selling the Millbury property.\n\n<strong>1999</strong>: Ballard Mack became Ballard Truck Center."
            },
            {
              "title": "Expansion",
              "years": "2001–2011",
              "text": "<strong>2001</strong>: Ballard Truck Center opened its 2nd location in Johnston, Rhode Island.\n\n<strong>2007</strong>: Samantha Grahn, Steve’s daughter, joined the company full-time.\n\n<strong>2010</strong>: A 3rd location is opened in West Springfield, Massachusetts.\n\n<strong>2011</strong>: A 4th location is opened in Avon, Massachusetts."
            },
